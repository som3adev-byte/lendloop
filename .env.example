# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Convex (set with `npx convex env set NAME value`, not in a file) ---
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# N8N_NOTIFY_URL=http://localhost:5678/webhook/lendloop-notify
# CONVEX_TO_N8N_SECRET=<openssl rand -hex 32>
# N8N_TO_CONVEX_SECRET=<openssl rand -hex 32>

# --- n8n (.env, read by docker-compose) ---
CONVEX_SITE_URL=http://host.docker.internal:3211
CONVEX_TO_N8N_SECRET=same value as in Convex
N8N_TO_CONVEX_SECRET=same value as in Convex
